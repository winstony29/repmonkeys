{
  "name": "wellness-onchainkit-app",
  "version": "1.0.0",
  "description": "Wellness app built with OnchainKit",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "dev:watch": "pnpm --filter playground dev:watch",
    "dev:backend": "pnpm --filter backend dev",
    "dev:contracts": "pnpm --filter contracts dev",
    "build": "pnpm --filter playground build",
    "build:contracts": "pnpm --filter contracts build",
    "deploy:contracts": "pnpm --filter contracts deploy",
    "dev:wellness": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter playground dev:watch\"",
    "f:play": "pnpm --filter playground",
    "f:backend": "pnpm --filter backend",
    "f:contracts": "pnpm --filter contracts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
