{
  "name": "wellness-app",
  "version": "1.0.0",
  "description": "Decentralized health and wellness application on Base blockchain",
  "private": true,
  "scripts": {
    "dev:backend": "cd packages/backend && npm run dev",
    "dev:miniapp": "cd packages/miniapp && npm run dev", 
    "dev:sogni": "cd packages/sogni-api && npm run dev",
    "build:contracts": "cd packages/contracts && npm run build",
    "build:miniapp": "cd packages/miniapp && npm run build",
    "build:sogni": "cd packages/sogni-api && npm run build",
    "deploy:contracts": "cd packages/contracts && npm run deploy",
    "deploy:contracts:sepolia": "cd packages/contracts && npm run deploy:sepolia",
    "deploy:contracts:goerli": "cd packages/contracts && npm run deploy:goerli",
    "deploy:contracts:mainnet": "cd packages/contracts && npm run deploy:mainnet",
    "test:contracts": "cd packages/contracts && npm run test",
    "install:all": "cd packages/backend && npm install && cd ../miniapp && npm install && cd ../contracts && npm install && cd ../sogni-api && npm install",
    "clean": "rm -rf node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
