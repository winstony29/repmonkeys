# Sogni AI Configuration
# Get these credentials from https://www.sogni.ai/

# Required: Unique application identifier (UUID recommended)
SOGNI_APP_ID=your-unique-app-id-here

# Required: Your Sogni account credentials
SOGNI_USERNAME=your-username
SOGNI_PASSWORD=your-password

# Optional: Network type ('fast' or 'relaxed', default: 'fast')
SOGNI_NETWORK=fast

# Optional: Enable fallback to Pollinations API if Sogni fails
ALLOW_SOGNI_FALLBACK=false

# Development
NODE_ENV=development
