# Miniapp Environment Variables

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Blockchain Configuration
NEXT_PUBLIC_BASE_GOERLI_RPC=https://goerli.base.org
NEXT_PUBLIC_BASE_MAINNET_RPC=https://mainnet.base.org

# Contract Addresses (set after deployment)
NEXT_PUBLIC_WELLNESS_NFT_ADDRESS=0x...
NEXT_PUBLIC_WELL_TOKEN_ADDRESS=0x...
NEXT_PUBLIC_REWARDS_CONTRACT_ADDRESS=0x...

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_ENABLE_NFT_FEATURES=true
NEXT_PUBLIC_ENABLE_TOKEN_FEATURES=true

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_KEY=your_analytics_key_here

