# Private key for contract deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC URLs
BASE_GOERLI_RPC=https://goerli.base.org
BASE_MAINNET_RPC=https://mainnet.base.org

# Etherscan API keys (optional, for contract verification)
ETHERSCAN_API_KEY_BASE_GOERLI=your_api_key_here
ETHERSCAN_API_KEY_BASE_MAINNET=your_api_key_here

